# PDF Toolbox — root ignore rules
# Per-directory rules also live in: src/, scripts/, src-tauri/, and
# src-tauri/resources/{qpdf,pdfium}/

# --- Dependencies ---
/node_modules/

# --- Build output ---
/dist/
/tmp/
/out-tsc/
/bazel-out/

# --- Angular ---
/.angular/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Test / coverage ---
/coverage/
*.lcov

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- TypeScript ---
*.tsbuildinfo

# --- IDEs and editors ---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
*.swp
*~

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Package managers (if used alongside npm) ---
.pnpm-store/
.yarn/
.pnp.*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Misc ---
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings
