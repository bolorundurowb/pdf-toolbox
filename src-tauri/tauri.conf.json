{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Toolbox",
  "version": "0.1.1",
  "identifier": "dev.bolorundurowb.pdf-toolbox",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/pdf-toolbox/browser"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Toolbox",
        "width": 960,
        "height": 630,
        "minWidth": 768,
        "minHeight": 510
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium": "pdfium"
    }
  }
}
